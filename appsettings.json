{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=rebloom.db"
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 587,
    "User": "your-smtp-user",
    "Pass": "your-smtp-pass",
    "From": "no-reply@example.com",
    "UseSsl": true
  },
  "Twilio": {
    "AccountSid": "YOUR_TWILIO_ACCOUNT_SID",
    "AuthToken": "YOUR_TWILIO_AUTH_TOKEN",
    "FromNumber": "+15551234567"
  }
}
